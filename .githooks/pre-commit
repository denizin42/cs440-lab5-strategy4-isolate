#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook: Block Direct Commits to `main` / `master`
# Enforces feature-branch workflow (e.g., feature/q-learning, feature/environment,
# feature/exploration) which also powers `scripts/context-switcher.sh`.
# ==============================================================================

set -euo pipefail

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
    echo "==============================================================================" >&2
    echo "ERROR [pre-commit]: Direct commits to '$BRANCH' are blocked!" >&2
    echo "" >&2
    echo "Please create and switch to a feature branch before committing, for example:" >&2
    echo "  git checkout -b feature/q-learning" >&2
    echo "  git checkout -b feature/environment" >&2
    echo "  git checkout -b feature/exploration" >&2
    echo "==============================================================================" >&2
    exit 1
fi
